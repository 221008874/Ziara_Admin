# Admin Panel - Environment Variables (SAFE TO COMMIT)
# Copy this file to .env and fill in real values (NEVER commit .env)

# Firebase Client SDK (used by src/firebase.js)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Cloudinary (used by src/lib/cloudinary.js)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Optional API base URL (defaults to "" — same origin)
VITE_API_BASE=

# =============================================================================
# SERVER-SIDE ENV VARS (NOT VITE_ prefix — set in Vercel dashboard, NOT in .env)
# Required by Vercel serverless functions under api/admin/*.js and api/sync/*.js
# =============================================================================
   # Admin SDK credentials — ONE PER FIREBASE PROJECT (server-side only).
   #
   # These are deliberately separate. A single shared credential would give one
   # key write access to both the clinical hub and the ERP, and nothing would stop
   # an ERP handler from writing into the clinic project. Each handler declares
   # which project it may touch, and api/_lib/firebase-admin.js refuses to start
   # if the credential's project_id does not match.
   #
   # Community / Admin Panel project (smartclinicadmin):
   #   servers, saas_*, sync_failures, and all Identity Toolkit (Auth) users.
   COMMUNITY_FIREBASE_SERVICE_ACCOUNT_B64=your_base64_encoded_json_here
   # Optional local-dev alternative to the _B64 form:
   # COMMUNITY_FIREBASE_SERVICE_ACCOUNT_PATH=C:\path\to\service-account.json

   # ERP project (ziara-erp-wep):
   #   inventory_*, purchase_orders, goods_receipts, procurement_audit_log.
   ERP_FIREBASE_SERVICE_ACCOUNT_B64=your_base64_encoded_json_here
   # ERP_FIREBASE_SERVICE_ACCOUNT_PATH=C:\path\to\erp-service-account.json

   # DEPRECATED: FIREBASE_SERVICE_ACCOUNT_JSON_BASE64
   # Only read as a migration aid, and only for the domain whose project_id it
   # actually matches. Set the two vars above and remove this one.
   # FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

   # Base64 of the JSON on a single line, e.g. PowerShell:
   #   [Convert]::ToBase64String([IO.File]::ReadAllBytes('sa.json'))

# Gmail credentials for sending OTP emails (REQUIRED for registration)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Owner email to receive OTP notifications (REQUIRED for registration)
OWNER_EMAIL=owner@example.com

# ERP Sync URL (REQUIRED for the "Sync ERP" button to work)
# Points to the ERP app's /api/integration/sync endpoint
ERP_SYNC_URL=https://your-erp-app.vercel.app/api/integration/sync

# ERP Sync Secret (REQUIRED — must match ERP_SYNC_SECRET in the ERP app)
ERP_SYNC_SECRET=your_erp_sync_secret